# =============================================
# TRUE TASTE — ENVIRONMENT VARIABLES TEMPLATE
# =============================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.

# ── Resend ────────────────────────────────────────────────────────────────
# Server-side only — NEVER expose via NEXT_PUBLIC_.
# https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key
# The from address must use a domain verified in Resend (e.g. truetaste.in)
RESEND_FROM_EMAIL=True Taste <noreply@truetaste.in>

# ── Site URL ──────────────────────────────────────────────────────────────
# Production: https://truetaste.in
# Local dev : http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://truetaste.in
