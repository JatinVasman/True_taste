# =============================================
# TRUE TASTE — ENVIRONMENT VARIABLES TEMPLATE
# =============================================
# Copy this file to .env.local and fill in your values.
#
# To connect Supabase: fill in your project URL and anon key.
# Get these from: https://app.supabase.com → Project Settings → API
# Never add the service_role key here (server only, in .env.local is fine BUT
# never expose it to the client via NEXT_PUBLIC_).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Razorpay (future — server-side only, never NEXT_PUBLIC_)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# Site URL (used by Supabase for email redirect links)
NEXT_PUBLIC_SITE_URL=https://www.truetaste.in
